# Local configuration and environment files
.env
.env.*
!.env.example
Config/Local.xcconfig

# Signing credentials and provisioning profiles
*.cer
*.key
*.mobileprovision
*.p12
*.p8
*.pem
*.pfx

# Swift/Xcode tooling caches
.build/
.swiftpm/
*.xccheckout
*.xcscmblueprint
